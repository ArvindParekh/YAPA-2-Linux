<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:j="using:YAPA.Avalonia.Journal"
        x:Class="YAPA.Avalonia.Journal.DayWindow"
        x:DataType="j:DayViewModel"
        Title="Your day · YAPA"
        Width="860" Height="900" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource WindowSurface}"
        FontFamily="{StaticResource UiFont}">

    <Window.Styles>
        <StyleInclude Source="avares://YAPA.Avalonia/Settings/SettingsStyles.axaml" />

        <Style Selector="TextBlock.weekday">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="LetterSpacing" Value="-0.4" />
        </Style>
        <Style Selector="TextBlock.date">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="Margin" Value="1,2,0,0" />
        </Style>

        <!-- The day at the top. -->
        <Style Selector="Border.hero">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#FF1F1F25" />
                    <GradientStop Offset="1" Color="#FF19191E" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24,22,24,20" />
        </Style>
        <Style Selector="TextBlock.headline">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LetterSpacing" Value="-0.2" />
        </Style>
        <Style Selector="TextBlock.summary">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="#FFB4B4BE" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.stats">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <!-- Project chips: a dot in the project's colour. -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,3,10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFC8C8D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip TextBlock.faint">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="BorderBrush" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="8,2,8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <!-- Sessions. -->
        <Style Selector="TextBlock.sessionLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.sessionRange">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="TextBlock.sessionTitle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.sessionSummary">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="#FFA2A2AC" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Pomodoros. -->
        <Style Selector="Border.entry">
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="18,14,12,12" />
        </Style>
        <Style Selector="ItemsControl.entries ContentPresenter:nth-child(n+2) > Border.entry">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="Border.entry:pointerover">
            <Setter Property="Background" Value="#06FFFFFF" />
        </Style>
        <Style Selector="TextBlock.time">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#FFD6D6DC" />
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="TextBlock.length">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Cursor" Value="Ibeam" />
        </Style>
        <Style Selector="TextBlock.title.blank">
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TextBlock.detail">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="#FF9C9CA6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.reveal">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.entry:pointerover Button.reveal">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.now">
            <Setter Property="Background" Value="#26FF6B57" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <!-- What happened, when an entry is opened. -->
        <Style Selector="TextBlock.evHead">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF8A8A95" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.evTime">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="TextBlock.evText">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="#FF9A9AA4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="3" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.evText.quote">
            <Setter Property="Foreground" Value="#FFC2C2CA" />
        </Style>

        <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Ellipse.pulse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- The date, and stepping through days. -->
        <Grid ColumnDefinitions="*,Auto" Margin="36,26,28,16">
            <StackPanel>
                <TextBlock Classes="weekday" Text="{Binding Weekday}" />
                <TextBlock Classes="date" Text="{Binding DateCaption}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="ghost icon" Command="{Binding PreviousCommand}" IsEnabled="{Binding HasPrevious}"
                        ToolTip.Tip="The day before" AutomationProperties.Name="Previous day">
                    <Path Classes="icon" Data="M 15 5 L 8 12 L 15 19" />
                </Button>
                <Button Classes="ghost" Content="Today" Command="{Binding TodayCommand}" IsVisible="{Binding !IsToday}" />
                <Button Classes="ghost icon" Command="{Binding NextCommand}" IsEnabled="{Binding HasNext}"
                        ToolTip.Tip="The day after" AutomationProperties.Name="Next day">
                    <Path Classes="icon" Data="M 9 5 L 16 12 L 9 19" />
                </Button>
                <Button x:Name="CopyButton" Classes="ghost" Click="OnCopyClick" Margin="8,0,0,0" IsEnabled="{Binding !IsEmpty}"
                        ToolTip.Tip="Copy the day as text, for a standup or a note">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="icon" Width="14" Height="14" Data="M 8 8 L 8 4.5 A 1.5 1.5 0 0 1 9.5 3 L 19.5 3 A 1.5 1.5 0 0 1 21 4.5 L 21 14.5 A 1.5 1.5 0 0 1 19.5 16 L 16 16 M 4.5 8 L 14.5 8 A 1.5 1.5 0 0 1 16 9.5 L 16 19.5 A 1.5 1.5 0 0 1 14.5 21 L 4.5 21 A 1.5 1.5 0 0 1 3 19.5 L 3 9.5 A 1.5 1.5 0 0 1 4.5 8 Z" />
                        <TextBlock x:Name="CopyLabel" Text="Copy" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,2,36,44" MaxWidth="800">

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,10,0,0" IsVisible="{Binding IsLoading}">
                    <Ellipse Classes="pulse" VerticalAlignment="Center" />
                    <TextBlock Classes="stats" Text="Reading your day…" VerticalAlignment="Center" />
                </StackPanel>

                <!-- A day without pomodoros. -->
                <Border Classes="hero" IsVisible="{Binding IsEmpty}" Padding="26,30">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="headline" Text="No pomodoros on this day." />
                        <TextBlock Classes="summary" Text="The journal is built around pomodoros: what you did in each one, put together after the fact. Start one and this page fills itself in." />
                    </StackPanel>
                </Border>

                <!-- The day in a few lines. -->
                <Border Classes="hero">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsEmpty" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="10">
                        <TextBlock Classes="headline" Text="{Binding Headline}" />
                        <TextBlock Classes="summary" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <TextBlock Classes="stats" Text="{Binding Stats}" />
                            <TextBlock Grid.Column="1" Classes="stats" Text="{Binding Span}" FontFeatures="+tnum" />
                        </Grid>
                        <j:DayRibbon x:Name="Ribbon" Blocks="{Binding Ribbon}" Start="{Binding RibbonStartLocal}" End="{Binding RibbonEndLocal}" />
                        <ItemsControl ItemsSource="{Binding ProjectTotals}" Margin="0,4,0,-6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="j:ProjectChip">
                                    <Border Classes="chip">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="faint" Text="{Binding Time}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border IsVisible="{Binding HasStatus}" Background="#0CFFFFFF" CornerRadius="10" Padding="12,8" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Classes="pulse" IsVisible="{Binding IsWriting}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Classes="stats" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                                    <Button Content="Sign in" Command="{Binding SignInCommand}" IsVisible="{Binding ShowSignIn}" />
                                    <Button Content="Try again" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Sessions, and the pomodoros in each. -->
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="j:SessionViewModel">
                            <StackPanel Margin="2,34,2,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="sessionLabel" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="sessionRange" Text="{Binding Range}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Classes="sessionTitle" Text="{Binding Title}" IsVisible="{Binding HasTitle}" />
                                <TextBlock Classes="sessionSummary" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" />
                                <Border Classes="card" Margin="-2,14,-2,0">
                                    <ItemsControl Classes="entries" ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="j:EntryViewModel">
                                                <Border Classes="entry">
                                                    <Grid ColumnDefinitions="62,18,*,Auto">
                                                        <StackPanel Margin="0,1,0,0">
                                                            <TextBlock Classes="time" Text="{Binding Start}" />
                                                            <TextBlock Classes="length" Text="{Binding Length}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Width="3" CornerRadius="2" Background="{Binding Color}"
                                                                HorizontalAlignment="Left" Margin="0,3,0,3" />

                                                        <StackPanel Grid.Column="2" Spacing="5">
                                                            <TextBlock Classes="title" Classes.blank="{Binding IsBlank}" Text="{Binding ShownTitle}"
                                                                       IsVisible="{Binding !IsEditing}" DoubleTapped="OnTitleDoubleTapped"
                                                                       ToolTip.Tip="Double-click to name it yourself" />
                                                            <TextBox Text="{Binding EditText}" IsVisible="{Binding IsEditing}" KeyDown="OnEditKeyDown"
                                                                     LostFocus="OnEditLostFocus" PlaceholderText="What was it? Leave empty to let the write-up name it"
                                                                     FontSize="14" Margin="-10,-6,0,-2" />
                                                            <TextBlock Classes="detail" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                                                            <Border Classes="now" IsVisible="{Binding InProgress}">
                                                                <TextBlock Text="UNDER WAY" FontSize="10.5" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <WrapPanel IsVisible="{Binding HasChips}" Margin="0,4,0,-6">
                                                                <ItemsControl ItemsSource="{Binding Projects}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="j:ProjectChip">
                                                                            <Border Classes="chip">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <Ellipse Width="6" Height="6" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding Name}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <ItemsControl ItemsSource="{Binding Badges}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                            <Border Classes="badge"><TextBlock Text="{Binding}" /></Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </WrapPanel>

                                                            <ItemsControl ItemsSource="{Binding Evidence}" IsVisible="{Binding IsExpanded}" Margin="0,10,0,2">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="j:EvidenceGroup">
                                                                        <StackPanel Margin="0,0,0,12" Spacing="4">
                                                                            <TextBlock Classes="evHead" Text="{Binding Heading}" />
                                                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="j:EvidenceLine">
                                                                                        <Grid ColumnDefinitions="48,*" Margin="0,1">
                                                                                            <TextBlock Classes="evTime" Text="{Binding Time}" />
                                                                                            <TextBlock Grid.Column="1" Classes="evText" Classes.quote="{Binding Quote}" Text="{Binding Text}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-4,0,0">
                                                            <Button Classes="ghost icon reveal" Command="{Binding EditCommand}" IsVisible="{Binding !InProgress}"
                                                                    ToolTip.Tip="Name it yourself" AutomationProperties.Name="Rename">
                                                                <Path Classes="icon" Width="13" Height="13" Data="M 4 20 L 4.8 16.2 L 15.8 5.2 A 2 2 0 0 1 18.8 8.2 L 7.8 19.2 Z M 13.8 7.2 L 16.8 10.2" />
                                                            </Button>
                                                            <Button Classes="ghost icon" Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding HasEvidence}"
                                                                    ToolTip.Tip="What happened" AutomationProperties.Name="Show what happened">
                                                                <Panel>
                                                                    <Path Classes="icon" Width="13" Height="13" Data="M 6 9 L 12 15 L 18 9" IsVisible="{Binding !IsExpanded}" />
                                                                    <Path Classes="icon" Width="13" Height="13" Data="M 6 15 L 12 9 L 18 15" IsVisible="{Binding IsExpanded}" />
                                                                </Panel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="4,26,4,0" Spacing="4" IsVisible="{Binding !IsEmpty}">
                    <TextBlock Classes="note" Text="{Binding Sources}" />
                    <TextBlock Classes="note" Foreground="{DynamicResource InkFaint}"
                               Text="Read on this computer, from inside pomodoros only. The write-up goes to Claude through your own sign-in, with anything that looks like a key or a password blanked. Settings → Journal says what's read." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
