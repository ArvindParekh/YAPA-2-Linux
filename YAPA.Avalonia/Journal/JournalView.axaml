<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:j="using:YAPA.Avalonia.Journal"
        x:Class="YAPA.Avalonia.Journal.JournalView"
        x:DataType="j:DayViewModel"
        Focusable="True"
        FontFamily="{StaticResource UiFont}">

    <UserControl.Styles>
        <StyleInclude Source="avares://YAPA.Avalonia/Settings/SettingsStyles.axaml" />

        <Style Selector="TextBlock.weekday">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="LetterSpacing" Value="-0.4" />
        </Style>
        <Style Selector="TextBlock.date">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="Margin" Value="1,2,0,0" />
        </Style>

        <!-- The day at the top. -->
        <Style Selector="Border.hero">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#FF1F1F25" />
                    <GradientStop Offset="1" Color="#FF19191E" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24,22,24,20" />
        </Style>
        <Style Selector="TextBlock.headline">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LetterSpacing" Value="-0.2" />
        </Style>
        <Style Selector="TextBlock.summary">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="#FFB4B4BE" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.stats">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <!-- Project chips: a dot in the project's colour. -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,3,10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFC8C8D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip TextBlock.faint">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="BorderBrush" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="8,2,8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <!-- Sessions. -->
        <Style Selector="TextBlock.sessionLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.sessionLabel.off">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="TextBlock.sessionRange">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="TextBlock.sessionTitle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.sessionSummary">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="#FFA2A2AC" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Pomodoros. -->
        <Style Selector="Border.entry">
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="18,14,12,12" />
        </Style>
        <Style Selector="ItemsControl.entries ContentPresenter:nth-child(n+2) > Border.entry">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="Border.entry:pointerover">
            <Setter Property="Background" Value="#06FFFFFF" />
        </Style>
        <Style Selector="TextBlock.time">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#FFD6D6DC" />
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="TextBlock.length">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Cursor" Value="Ibeam" />
        </Style>
        <Style Selector="TextBlock.title.blank">
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <!-- Time off the timer: there, quieter than the pomodoros. -->
        <Style Selector="Border.entry.off TextBlock.title">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#FFB6B6BF" />
        </Style>
        <Style Selector="Border.entry.off TextBlock.time">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <!-- A pomodoro off the record: there, and nothing more. -->
        <Style Selector="Border.entry.offRecord TextBlock.title">
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="TextBlock.detail">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="#FF9C9CA6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.reveal">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.entry:pointerover Button.reveal">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.now">
            <Setter Property="Background" Value="#26FF6B57" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <!-- What happened, when an entry is opened. -->
        <Style Selector="TextBlock.evHead">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF8A8A95" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.evTime">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="TextBlock.evText">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="#FF9A9AA4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="3" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.evText.quote">
            <Setter Property="Foreground" Value="#FFC2C2CA" />
        </Style>

        <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Flyouts: the calendar, and forgetting. Raised a step above the window, like a card. -->
        <Style Selector="FlyoutPresenter.day">
            <Setter Property="Background" Value="#FF1F1F25" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,16,18,16" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>
        <Style Selector="TextBlock.flyTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.flyNote">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.flySub">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="TextBlock.problem">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FFFF8F7F" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox.time">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chipButton">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="#FFC8C8D0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11,4,11,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <!-- The one button that deletes: the accent, so it reads as the consequence it is. -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF16161A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,6,16,7" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF7D6B" />
            <Setter Property="Foreground" Value="#FF16161A" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFE04E3B" />
            <Setter Property="Foreground" Value="#FF16161A" />
        </Style>

        <!-- Day | Week: two halves of one pill, the one shown filled. -->
        <Style Selector="Border.segments">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,4,12,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="Button.segment.on">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.segment.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>

        <!-- A day in the week: the whole row opens it. -->
        <Style Selector="Button.weekRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,13,14,13" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ItemsControl.entries ContentPresenter:nth-child(n+2) > Button.weekRow">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="Button.weekRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
        </Style>
        <Style Selector="Button.weekRow.empty TextBlock.title">
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.weekRow.future">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.weekRow.future:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.weekRow.today TextBlock.time">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ProgressBar.dayFocus">
            <Setter Property="Height" Value="5" />
            <Setter Property="MinHeight" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.count">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
        <!-- The date, which opens the calendar. -->
        <Style Selector="Button.dateButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6,14,8" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.dateButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF" />
        </Style>
        <Style Selector="Button.dateButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12FFFFFF" />
        </Style>
        <Style Selector="TextBlock.calTitle">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="TextBlock.calHead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.calDay">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#FFD6D6DC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="Button.calDay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="Button.calDay.out">
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
        </Style>
        <Style Selector="Button.calDay:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="Button.calDay:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.calDay.today /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#59FF6B57" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.calDay.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FF6B57" />
        </Style>
        <Style Selector="Button.calDay.selected">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Off the record, said at the top while it lasts. -->
        <Style Selector="Border.banner">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10,10,10" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style Selector="Ellipse.pulse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Only while it shows: a hidden one animating keeps the renderer busy all the time. -->
        <Style Selector="Ellipse.pulse[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- The date, and stepping through days. -->
        <Grid ColumnDefinitions="*,Auto" Margin="36,26,28,16">
            <Button x:Name="DateButton" Classes="dateButton" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,-6,0,-8"
                    ToolTip.Tip="Go to any day (C)" AutomationProperties.Name="Choose a day">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="day" Opening="OnCalendarOpening">
                        <StackPanel Width="290" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                                <TextBlock Classes="calTitle" Text="{Binding CalendarTitle}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Classes="ghost icon" Command="{Binding CalendarPreviousCommand}"
                                        ToolTip.Tip="The month before" AutomationProperties.Name="Previous month">
                                    <Path Classes="icon" Width="13" Height="13" Data="M 15 5 L 8 12 L 15 19" />
                                </Button>
                                <Button Grid.Column="2" Classes="ghost icon" Command="{Binding CalendarNextCommand}" IsEnabled="{Binding CanCalendarNext}"
                                        ToolTip.Tip="The month after" AutomationProperties.Name="Next month">
                                    <Path Classes="icon" Width="13" Height="13" Data="M 9 5 L 16 12 L 9 19" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding WeekdayInitials}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="calHead" Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="j:CalendarDay">
                                        <Button Classes="calDay" Classes.out="{Binding !InMonth}" Classes.today="{Binding IsToday}"
                                                Classes.selected="{Binding IsSelected}" IsEnabled="{Binding CanPick}"
                                                Command="{Binding $parent[ItemsControl].((j:DayViewModel)DataContext).PickDayCommand}" CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Label}">
                                            <Panel>
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3" />
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Opacity="{Binding DotOpacity}"
                                                         IsVisible="{Binding HasPomodoros}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource InkFaint}"
                                                         IsVisible="{Binding OnlyPresence}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="4,6,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Classes="calHead" Text="pomodoros" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource InkFaint}" VerticalAlignment="Center" />
                                    <TextBlock Classes="calHead" Text="at the computer" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Classes="weekday" Text="{Binding Weekday}" />
                        <Path Classes="icon" Width="12" Height="12" Data="M 6 9 L 12 15 L 18 9" VerticalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBlock Classes="date" Text="{Binding DateCaption}" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- A day, or the week around it (W). -->
                <Border Classes="segments" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="segment" Classes.on="{Binding IsDay}" Content="Day" Command="{Binding ShowDayViewCommand}" />
                        <Button Classes="segment" Classes.on="{Binding IsWeek}" Content="Week" Command="{Binding ShowWeekCommand}" />
                    </StackPanel>
                </Border>
                <Button Classes="ghost icon" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoBack}"
                        ToolTip.Tip="Before" AutomationProperties.Name="Previous">
                    <Path Classes="icon" Data="M 15 5 L 8 12 L 15 19" />
                </Button>
                <Button Classes="ghost" Content="Today" Command="{Binding TodayCommand}" IsVisible="{Binding !AtToday}" />
                <Button Classes="ghost icon" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoForward}"
                        ToolTip.Tip="After" AutomationProperties.Name="Next">
                    <Path Classes="icon" Data="M 9 5 L 16 12 L 9 19" />
                </Button>
                <Button x:Name="ForgetButton" Classes="ghost" Margin="8,0,0,0" IsVisible="{Binding IsDay}"
                        ToolTip.Tip="Forget a stretch of time, or keep what's next off the record">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="day" Opening="OnForgetOpening">
                            <StackPanel Width="350" Spacing="12">
                                <TextBlock Classes="flyTitle" Text="Forget a stretch of time" />
                                <TextBlock Classes="flyNote"
                                           Text="The windows recorded in it and every write-up of it are deleted, and nothing your browser or Claude Code kept from that time is read again. Pomodoros stay, and still count." />
                                <Grid ColumnDefinitions="Auto,72,Auto,72" VerticalAlignment="Center">
                                    <TextBlock Classes="flyNote" Text="From" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Grid.Column="1" Classes="time" Text="{Binding ForgetFrom}" PlaceholderText="21:40" />
                                    <TextBlock Grid.Column="2" Classes="flyNote" Text="to" VerticalAlignment="Center" Margin="10,0" />
                                    <TextBox Grid.Column="3" Classes="time" Text="{Binding ForgetTo}" PlaceholderText="now" />
                                </Grid>
                                <WrapPanel Margin="0,0,0,-6">
                                    <Button Classes="chipButton" Content="Last 15 minutes" Command="{Binding ForgetPresetCommand}" CommandParameter="15" IsVisible="{Binding IsToday}" />
                                    <Button Classes="chipButton" Content="Last hour" Command="{Binding ForgetPresetCommand}" CommandParameter="60" IsVisible="{Binding IsToday}" />
                                    <Button Classes="chipButton" Content="Today so far" Command="{Binding ForgetPresetCommand}" CommandParameter="day" IsVisible="{Binding IsToday}" />
                                    <Button Classes="chipButton" Content="The whole day" Command="{Binding ForgetPresetCommand}" CommandParameter="day" IsVisible="{Binding !IsToday}" />
                                </WrapPanel>
                                <CheckBox IsChecked="{Binding ForgetConversations}" IsVisible="{Binding HasForgetConversations}">
                                    <TextBlock Classes="flyNote" Text="{Binding ForgetConversationsText}" />
                                </CheckBox>
                                <TextBlock Classes="problem" Text="{Binding ForgetProblem}" IsVisible="{Binding HasForgetProblem}" />
                                <Button Classes="danger" Content="Forget" HorizontalAlignment="Right" Click="OnForgetRangeClick" />

                                <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,2" />
                                <TextBlock Classes="flySub" Text="KEEP WHAT'S NEXT OFF THE RECORD" />
                                <WrapPanel Margin="0,0,0,-6" IsVisible="{Binding !IsOffRecord}">
                                    <Button Classes="chipButton" Content="30 minutes" Command="{Binding GoOffRecordCommand}" CommandParameter="30" Click="OnFlyoutDone" />
                                    <Button Classes="chipButton" Content="An hour" Command="{Binding GoOffRecordCommand}" CommandParameter="60" Click="OnFlyoutDone" />
                                    <Button Classes="chipButton" Content="Until I turn it back on" Command="{Binding GoOffRecordCommand}" CommandParameter="" Click="OnFlyoutDone" />
                                </WrapPanel>
                                <StackPanel Spacing="8" IsVisible="{Binding IsOffRecord}">
                                    <TextBlock Classes="flyNote" Text="{Binding OffRecordText}" />
                                    <Button Classes="chipButton" Content="Back on the record" Command="{Binding BackOnRecordCommand}" Click="OnFlyoutDone" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="icon" Width="14" Height="14" Data="M 4.5 7 L 19.5 7 M 9.5 7 L 9.5 4.5 L 14.5 4.5 L 14.5 7 M 6.5 7 L 7.4 19.5 L 16.6 19.5 L 17.5 7 M 10.2 10.5 L 10.4 16 M 13.8 10.5 L 13.6 16" />
                        <TextBlock Text="Forget" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Classes="ghost" Click="OnCopyClick" Margin="2,0,0,0" IsEnabled="{Binding !IsEmpty}"
                        ToolTip.Tip="Copy the day as text, for a standup or a note">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="icon" Width="14" Height="14" Data="M 8 8 L 8 4.5 A 1.5 1.5 0 0 1 9.5 3 L 19.5 3 A 1.5 1.5 0 0 1 21 4.5 L 21 14.5 A 1.5 1.5 0 0 1 19.5 16 L 16 16 M 4.5 8 L 14.5 8 A 1.5 1.5 0 0 1 16 9.5 L 16 19.5 A 1.5 1.5 0 0 1 14.5 21 L 4.5 21 A 1.5 1.5 0 0 1 3 19.5 L 3 9.5 A 1.5 1.5 0 0 1 4.5 8 Z" />
                        <TextBlock x:Name="CopyLabel" Text="Copy" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <Panel>
            <StackPanel Margin="36,2,36,44" MaxWidth="800" IsVisible="{Binding IsDay}">

                <Border Classes="banner" IsVisible="{Binding IsOffRecord}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Classes="icon" Width="15" Height="15" Data="M 17.94 17.94 A 10.07 10.07 0 0 1 12 20 C 5 20 1 12 1 12 A 18.45 18.45 0 0 1 6.06 6.06 M 9.9 4.24 A 9.12 9.12 0 0 1 12 4 C 19 4 23 12 23 12 A 18.5 18.5 0 0 1 20.84 15.19 M 14.12 14.12 A 3 3 0 1 1 9.88 9.88 M 1 1 L 23 23" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Classes="stats" Text="{Binding OffRecordText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Back on the record" Command="{Binding BackOnRecordCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="banner" IsVisible="{Binding HasNotice}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Classes="icon" Width="15" Height="15" Data="M 4.5 7 L 19.5 7 M 9.5 7 L 9.5 4.5 L 14.5 4.5 L 14.5 7 M 6.5 7 L 7.4 19.5 L 16.6 19.5 L 17.5 7 M 10.2 10.5 L 10.4 16 M 13.8 10.5 L 13.6 16" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Classes="stats" Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,14" IsVisible="{Binding IsForgetting}">
                    <Ellipse Classes="pulse" VerticalAlignment="Center" IsVisible="{Binding IsForgetting}" />
                    <TextBlock Classes="stats" Text="Forgetting…" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,10,0,0" IsVisible="{Binding IsLoading}">
                    <Ellipse Classes="pulse" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
                    <TextBlock Classes="stats" Text="Reading your day…" VerticalAlignment="Center" />
                </StackPanel>

                <!-- A day with nothing on record. -->
                <Border Classes="hero" IsVisible="{Binding IsEmpty}" Padding="26,30">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="headline" Text="Nothing on record for this day." />
                        <TextBlock Classes="summary" Text="No pomodoros, and nothing from your conversations, commits, browsing or windows. Once there is, this page puts it together on its own." />
                    </StackPanel>
                </Border>

                <!-- The day in a few lines. -->
                <Border Classes="hero">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsEmpty" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="10">
                        <TextBlock Classes="headline" Text="{Binding Headline}" />
                        <TextBlock Classes="summary" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <TextBlock Classes="stats" Text="{Binding Stats}" />
                            <TextBlock Grid.Column="1" Classes="stats" Text="{Binding Span}" FontFeatures="+tnum" />
                        </Grid>
                        <j:DayRibbon x:Name="Ribbon" Blocks="{Binding Ribbon}" Start="{Binding RibbonStartLocal}" End="{Binding RibbonEndLocal}" />
                        <ItemsControl ItemsSource="{Binding ProjectTotals}" Margin="0,4,0,-6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="j:ProjectChip">
                                    <Border Classes="chip">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="faint" Text="{Binding Time}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border IsVisible="{Binding HasStatus}" Background="#0CFFFFFF" CornerRadius="10" Padding="12,8" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Classes="pulse" IsVisible="{Binding IsWriting}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Classes="stats" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                                    <Button Content="Sign in" Command="{Binding SignInCommand}" IsVisible="{Binding ShowSignIn}" />
                                    <Button Content="Try again" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Sessions, and the pomodoros in each. -->
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="j:SessionViewModel">
                            <StackPanel Margin="2,34,2,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="sessionLabel" Classes.off="{Binding IsOffTimer}" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="sessionRange" Text="{Binding Range}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Classes="sessionTitle" Text="{Binding Title}" IsVisible="{Binding HasTitle}" />
                                <TextBlock Classes="sessionSummary" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" />
                                <Border Classes="card" Margin="-2,14,-2,0">
                                    <ItemsControl Classes="entries" ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="j:EntryViewModel">
                                                <Border Classes="entry" Classes.off="{Binding IsOffTimer}" Classes.offRecord="{Binding IsOffRecord}">
                                                    <Grid ColumnDefinitions="62,18,*,Auto">
                                                        <StackPanel Margin="0,1,0,0">
                                                            <TextBlock Classes="time" Text="{Binding Start}" />
                                                            <TextBlock Classes="length" Text="{Binding Length}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Width="3" CornerRadius="2" Background="{Binding Color}"
                                                                HorizontalAlignment="Left" Margin="0,3,0,3" />

                                                        <StackPanel Grid.Column="2" Spacing="5">
                                                            <TextBlock Classes="title" Classes.blank="{Binding IsBlank}" Text="{Binding ShownTitle}"
                                                                       IsVisible="{Binding !IsEditing}" DoubleTapped="OnTitleDoubleTapped"
                                                                       ToolTip.Tip="Double-click to name it yourself" />
                                                            <TextBox Text="{Binding EditText}" IsVisible="{Binding IsEditing}" KeyDown="OnEditKeyDown"
                                                                     LostFocus="OnEditLostFocus" PlaceholderText="What was it? Leave empty to let the write-up name it"
                                                                     FontSize="14" Margin="-10,-6,0,-2" />
                                                            <TextBlock Classes="detail" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                                                            <Border Classes="now" IsVisible="{Binding InProgress}">
                                                                <TextBlock Text="{Binding NowLabel}" FontSize="10.5" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <WrapPanel IsVisible="{Binding HasChips}" Margin="0,4,0,-6">
                                                                <ItemsControl ItemsSource="{Binding Projects}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="j:ProjectChip">
                                                                            <Border Classes="chip">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <Ellipse Width="6" Height="6" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding Name}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <ItemsControl ItemsSource="{Binding Badges}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                            <Border Classes="badge"><TextBlock Text="{Binding}" /></Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </WrapPanel>

                                                            <ItemsControl ItemsSource="{Binding Evidence}" IsVisible="{Binding IsExpanded}" Margin="0,10,0,2">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="j:EvidenceGroup">
                                                                        <StackPanel Margin="0,0,0,12" Spacing="4">
                                                                            <TextBlock Classes="evHead" Text="{Binding Heading}" />
                                                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="j:EvidenceLine">
                                                                                        <Grid ColumnDefinitions="48,*" Margin="0,1">
                                                                                            <TextBlock Classes="evTime" Text="{Binding Time}" />
                                                                                            <TextBlock Grid.Column="1" Classes="evText" Classes.quote="{Binding Quote}" Text="{Binding Text}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-4,0,0">
                                                            <Button Classes="ghost icon reveal" IsVisible="{Binding CanForget}"
                                                                    ToolTip.Tip="Forget this" AutomationProperties.Name="Forget">
                                                                <Button.Flyout>
                                                                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="day" Opening="OnEntryForgetOpening">
                                                                        <StackPanel Width="310" Spacing="10">
                                                                            <TextBlock Classes="flyTitle" Text="{Binding ForgetQuestion}" />
                                                                            <TextBlock Classes="flyNote" Text="{Binding ForgetNote}" />
                                                                            <CheckBox IsChecked="{Binding ForgetConversations}" IsVisible="{Binding HasConversations}">
                                                                                <TextBlock Classes="flyNote" Text="{Binding ConversationsText}" />
                                                                            </CheckBox>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                                                                                <Button Classes="ghost" Content="Cancel" Click="OnFlyoutDone" />
                                                                                <Button Classes="danger" Content="Forget" Command="{Binding ForgetCommand}" Click="OnFlyoutDone" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                                <Path Classes="icon" Width="13" Height="13" Data="M 4.5 7 L 19.5 7 M 9.5 7 L 9.5 4.5 L 14.5 4.5 L 14.5 7 M 6.5 7 L 7.4 19.5 L 16.6 19.5 L 17.5 7 M 10.2 10.5 L 10.4 16 M 13.8 10.5 L 13.6 16" />
                                                            </Button>
                                                            <Button Classes="ghost icon reveal" Command="{Binding EditCommand}" IsVisible="{Binding CanRename}"
                                                                    ToolTip.Tip="Name it yourself" AutomationProperties.Name="Rename">
                                                                <Path Classes="icon" Width="13" Height="13" Data="M 4 20 L 4.8 16.2 L 15.8 5.2 A 2 2 0 0 1 18.8 8.2 L 7.8 19.2 Z M 13.8 7.2 L 16.8 10.2" />
                                                            </Button>
                                                            <Button Classes="ghost icon" Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding HasEvidence}"
                                                                    ToolTip.Tip="What happened" AutomationProperties.Name="Show what happened">
                                                                <Panel>
                                                                    <Path Classes="icon" Width="13" Height="13" Data="M 6 9 L 12 15 L 18 9" IsVisible="{Binding !IsExpanded}" />
                                                                    <Path Classes="icon" Width="13" Height="13" Data="M 6 15 L 12 9 L 18 15" IsVisible="{Binding IsExpanded}" />
                                                                </Panel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="4,26,4,0" Spacing="4" IsVisible="{Binding !IsEmpty}">
                    <TextBlock Classes="note" Text="{Binding Sources}" />
                    <TextBlock Classes="note" Foreground="{DynamicResource InkFaint}"
                               Text="{Binding PrivacyNote}" />
                </StackPanel>
            </StackPanel>

            <!-- Your week: the days, the projects across them, and the week in a few lines. -->
            <Panel IsVisible="{Binding IsWeek}">
            <StackPanel Margin="36,2,36,44" MaxWidth="800" DataContext="{Binding Week}" x:DataType="j:WeekViewModel">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,10,0,0" IsVisible="{Binding IsLoading}">
                    <Ellipse Classes="pulse" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
                    <TextBlock Classes="stats" Text="Reading your week…" VerticalAlignment="Center" />
                </StackPanel>

                <Border Classes="hero">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsEmpty" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="10">
                        <TextBlock Classes="headline" Text="{Binding Headline}" />
                        <TextBlock Classes="summary" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" />
                        <TextBlock Classes="stats" Text="{Binding Stats}" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{Binding Projects}" Margin="0,4,0,-6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="j:ProjectChip">
                                    <Border Classes="chip">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="faint" Text="{Binding Time}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border IsVisible="{Binding HasStatus}" Background="#0CFFFFFF" CornerRadius="10" Padding="12,8" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Classes="pulse" IsVisible="{Binding IsWriting}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Classes="stats" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                                    <Button Content="Sign in" Command="{Binding SignInCommand}" IsVisible="{Binding ShowSignIn}" />
                                    <Button Content="Try again" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="hero" IsVisible="{Binding IsEmpty}" Padding="26,30">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="headline" Text="Nothing on record this week." />
                        <TextBlock Classes="summary" Text="No pomodoros, and nothing from your conversations, commits, browsing or windows." />
                    </StackPanel>
                </Border>

                <TextBlock Classes="sessionLabel off" Text="THE DAYS" Margin="2,30,0,12" IsVisible="{Binding !IsLoading}" />
                <Border Classes="card" IsVisible="{Binding !IsLoading}">
                    <ItemsControl Classes="entries" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="j:WeekDayRow">
                                <Button Classes="weekRow" Classes.today="{Binding IsToday}" Classes.empty="{Binding IsEmpty}" Classes.future="{Binding IsFuture}"
                                        Click="OnWeekDayClick" AutomationProperties.Name="{Binding DateText}">
                                    <Grid ColumnDefinitions="78,150,*,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="time" Text="{Binding Weekday}" />
                                            <TextBlock Classes="length" Text="{Binding DateText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" Margin="0,0,22,0">
                                            <ProgressBar Classes="dayFocus" Minimum="0" Maximum="1" Value="{Binding Fraction}" IsVisible="{Binding !IsFuture}" />
                                            <TextBlock Classes="length" Text="{Binding Focus}" Margin="0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="title" Classes.blank="{Binding !IsWritten}" Text="{Binding Headline}"
                                                   VerticalAlignment="Center" MaxLines="2" TextTrimming="CharacterEllipsis" Cursor="Hand" />
                                        <TextBlock Grid.Column="3" Classes="count" Text="{Binding Count}" VerticalAlignment="Center" Margin="14,0,4,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
            </Panel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
