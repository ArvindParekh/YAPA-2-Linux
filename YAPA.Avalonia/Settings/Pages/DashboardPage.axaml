<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YAPA.Avalonia.Settings.Pages.DashboardPage"
             x:CompileBindings="False">

    <StackPanel Spacing="12">
        <TextBlock Text="Dashboard" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />

        <!-- Today -->
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Completed today:" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CompletedToday}"
                           FontSize="32" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Text="🍅" FontSize="24" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FocusedTodayDisplay}"
                           VerticalAlignment="Center"
                           Foreground="Gray" FontSize="13" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- This week summary -->
        <TextBlock Text="Last 7 days" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding WeekSummary}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="100,*,40" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Day}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding Count}"
                                     Maximum="{Binding MaxCount}"
                                     Height="14"
                                     Margin="4,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Refresh" Click="OnRefreshClick"
                HorizontalAlignment="Left" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
