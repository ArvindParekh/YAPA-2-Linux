<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YAPA.Avalonia.Settings.Pages.ThemeSettingsPage"
             x:CompileBindings="False">

    <StackPanel Spacing="10">
        <TextBlock Text="Appearance" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />

        <Grid>
            <Grid.Styles>
                <Style Selector="TextBlock.Label">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Width" Value="170" />
                </Style>
            </Grid.Styles>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Widget width -->
            <TextBlock Classes="Label" Grid.Row="0" Text="Widget width (px)" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,2,0,2">
                <Slider Minimum="80" Maximum="600"
                        Value="{Binding WidgetWidth, Mode=TwoWay}"
                        Width="160" TickFrequency="10" />
                <TextBlock Text="{Binding WidgetWidth}" VerticalAlignment="Center" Width="36" />
            </StackPanel>

            <!-- Clock opacity -->
            <TextBlock Classes="Label" Grid.Row="1" Text="Clock opacity" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,2,0,2">
                <Slider Minimum="0.1" Maximum="1.0"
                        Value="{Binding ClockOpacity, Mode=TwoWay}"
                        Width="160" TickFrequency="0.1" />
                <TextBlock Text="{Binding ClockOpacityDisplay}" VerticalAlignment="Center" Width="36" />
            </StackPanel>

            <!-- Text color -->
            <TextBlock Classes="Label" Grid.Row="2" Text="Text color (hex)" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,2,0,2"
                     Text="{Binding TextColorHex, Mode=TwoWay}"
                     PlaceholderText="#FFFFFFFF" Width="160"
                     HorizontalAlignment="Left" />

            <!-- Shadow color -->
            <TextBlock Classes="Label" Grid.Row="3" Text="Shadow color (hex)" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="8,2,0,2"
                     Text="{Binding ShadowColorHex, Mode=TwoWay}"
                     PlaceholderText="#FF000000" Width="160"
                     HorizontalAlignment="Left" />

        </Grid>

        <Separator />

        <CheckBox IsChecked="{Binding DisableFlashingAnimation, Mode=TwoWay}"
                  Content="Disable flashing animation" />
        <CheckBox IsChecked="{Binding ShowStatusText, Mode=TwoWay}"
                  Content="Show phase status text" />
        <CheckBox IsChecked="{Binding HideSeconds, Mode=TwoWay}"
                  Content="Hide seconds" />
        <CheckBox IsChecked="{Binding HideButtons, Mode=TwoWay}"
                  Content="Hide buttons (show on hover only)" />
        <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                  Content="Minimize to tray instead of taskbar" />
    </StackPanel>
</UserControl>
