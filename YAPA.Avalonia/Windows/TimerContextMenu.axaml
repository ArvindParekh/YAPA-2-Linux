<ContextMenu xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YAPA.Avalonia.ViewModels"
             x:Class="YAPA.Avalonia.Windows.TimerContextMenu"
             x:DataType="vm:TimerViewModel">
    <!-- Today against the goal. Disabled: it's information, not an action. -->
    <MenuItem Header="{Binding GoalSummary}" IsVisible="{Binding HasGoal}" IsEnabled="False" />
    <MenuItem Header="{Binding GoalWithoutLongBreaks}" IsVisible="{Binding HasGoalWithoutLongBreaks}" IsEnabled="False" />
    <Separator IsVisible="{Binding HasGoal}" />
    <MenuItem Header="{Binding StartMenuText}" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" InputGesture="Space" />
    <MenuItem Header="Pause" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" InputGesture="Space" />
    <MenuItem Header="Skip break" Command="{Binding SkipCommand}" IsVisible="{Binding CanSkip}" InputGesture="S" />
    <MenuItem Header="{Binding LongBreakMenuText}" Command="{Binding LongBreakCommand}" IsVisible="{Binding CanLongBreak}" InputGesture="L" />
    <MenuItem Header="{Binding StopMenuText}" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" InputGesture="Escape" />
    <!-- No key shortcut, unlike its neighbours: it writes history, and a stray keypress has no undo. -->
    <MenuItem Header="Mark a pomodoro done" Command="{Binding MarkDoneCommand}" IsVisible="{Binding CanMarkDone}" />
    <MenuItem Header="Reset cycle" Command="{Binding ResetCommand}" IsEnabled="{Binding CanReset}" />
    <Separator />
    <MenuItem Header="{Binding AmbienceMenuText}" Command="{Binding ToggleAmbienceCommand}"
              ToggleType="CheckBox" IsChecked="{Binding AmbienceOn, Mode=OneWay}" />
    <Separator />
    <MenuItem Header="Statistics…" Command="{Binding OpenStatisticsCommand}" InputGesture="Ctrl+I" />
    <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" InputGesture="Ctrl+OemComma" />
    <Separator />
    <MenuItem Header="Hide to tray" Command="{Binding HideToTrayCommand}" InputGesture="Ctrl+H" />
    <MenuItem Header="Quit YAPA" Command="{Binding QuitCommand}" InputGesture="Ctrl+Q" />
</ContextMenu>
