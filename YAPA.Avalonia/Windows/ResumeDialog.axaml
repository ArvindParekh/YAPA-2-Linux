<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="YAPA.Avalonia.Windows.ResumeDialog"
        Title="Unfinished Pomodoro"
        Width="320" Height="120"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="16" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="YesButton" Content="Resume" Click="OnYesClick" Width="80" />
            <Button x:Name="NoButton" Content="Discard" Click="OnNoClick" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
