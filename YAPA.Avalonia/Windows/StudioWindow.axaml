<w:TimerWindowBase xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:w="using:YAPA.Avalonia.Windows"
                   xmlns:vm="using:YAPA.Avalonia.ViewModels"
                   x:Class="YAPA.Avalonia.Windows.StudioWindow"
                   x:Name="Root"
                   x:DataType="vm:TimerViewModel"
                   Classes="transparent"
                   RenderOptions.TextRenderingMode="Antialias"
                   Width="328" Height="132">

    <!--
      The Studio timer: one card. A status line (the state's dot and word, the cycle, today's
      count), the time in Geist (tabular figures), one round button for what's next, and a hairline of
      progress along the bottom in the state's colour. Skip and stop wait for the pointer.
      The card floats in a transparent margin that holds its shadow; clicks there go through.
    -->
    <w:TimerWindowBase.Styles>
        <Style Selector="Border#Card">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F51A1A1E" />
                    <GradientStop Offset="1" Color="#F5111114" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#26FFFFFF" />
                    <GradientStop Offset="1" Color="#0DFFFFFF" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 14 32 -10 #C0000000, 0 2 6 0 #50000000" />
        </Style>

        <!-- An interval ended: the card's edge breathes in its colour until it's seen. -->
        <Style Selector="Border#Glow">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{Binding #Root.StateBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border#Glow.on">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border#Glow.on.still">
            <Style.Animations />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="TextBlock.state">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#FFEDEDEF" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontFeatures" Value="+tnum,+zero" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FF71717A" />
        </Style>
        <!-- Words in the status line (a note, the goal's forecast) read as words: Geist, not mono. -->
        <Style Selector="TextBlock.meta.prose">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Geist with tabular figures: digits that don't jump as they change, and a colon that doesn't gape the way a monospace one does. -->
        <Style Selector="TextBlock.digits">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="FontSize" Value="48" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="LetterSpacing" Value="-1.5" />
            <Setter Property="Foreground" Value="#FFEDEDEF" />
        </Style>
        <Style Selector="TextBlock.digits.overrun">
            <Setter Property="Foreground" Value="{StaticResource Hold}" />
        </Style>

        <!-- The one button: white, round, the next thing to do. -->
        <Style Selector="Button.go">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFEDEDEF" />
            <Setter Property="Foreground" Value="#FF09090B" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.go:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Button.go:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFD4D4D8" />
        </Style>
        <Style Selector="Button.go Path">
            <Setter Property="Fill" Value="#FF09090B" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <!-- Quiet icon buttons: skip, stop, the window's own. -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFA1A1AA" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="#FFEDEDEF" />
        </Style>
        <Style Selector="Button.icon.small">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.icon Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <!-- What waits for the pointer fades in and out rather than popping. -->
        <Style Selector=":is(Control).reveal">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=":is(Control).reveal.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector=":is(Control).calm">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=":is(Control).calm.hidden">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </w:TimerWindowBase.Styles>

    <Panel>
        <Viewbox x:Name="Scale" Stretch="Uniform">
            <!-- 16 px of margin all round: the shadow's room. -->
            <Panel Width="328" Height="132">
                <Border x:Name="Card" Margin="16" Width="296" Height="100">
                    <Panel>
                        <Grid RowDefinitions="Auto,*" Margin="16,12,12,0">
                            <!-- The status line. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="22">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{Binding #Root.StateBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusLabel" Classes="state" Text="{Binding StatusText}" VerticalAlignment="Center" />
                                    <TextBlock Classes="meta" Text="{Binding #Root.CycleText}" VerticalAlignment="Center" Margin="1,1,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="meta prose" Text="{Binding #Root.AsideText}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="10,1,8,0" Classes.calm="True" Classes.hidden="{Binding #Root.Hovering}" />
                                <!-- Right: what's at a glance, and on hover, the window's own buttons in its place. -->
                                <Panel Grid.Column="2">
                                    <StackPanel x:Name="Glance" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Classes="calm"
                                                Classes.hidden="{Binding #Root.Hovering}" Margin="0,0,4,0">
                                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Quiet}" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding IsOffRecord}" VerticalAlignment="Center"
                                              Data="M 17.94 17.94 A 10.07 10.07 0 0 1 12 20 C 5 20 1 12 1 12 A 18.45 18.45 0 0 1 6.06 6.06 M 9.9 4.24 A 9.12 9.12 0 0 1 12 4 C 19 4 23 12 23 12 A 18.5 18.5 0 0 1 20.84 15.19 M 14.12 14.12 A 3 3 0 1 1 9.88 9.88 M 1 1 L 23 23" />
                                        <TextBlock Classes="meta" Text="{Binding CounterText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="1" Classes="reveal" Classes.shown="{Binding #Root.Hovering}"
                                                HorizontalAlignment="Right" Margin="0,-3,-4,0">
                                        <Button x:Name="MenuButton" Classes="icon small" Click="OnMenuClick" AutomationProperties.Name="Actions">
                                            <Path Width="12" Height="3" Fill="{Binding $parent[Button].Foreground}" StrokeThickness="0"
                                                  Data="M 1.5 0 A 1.5 1.5 0 1 1 1.5 3 A 1.5 1.5 0 1 1 1.5 0 Z M 6 0 A 1.5 1.5 0 1 1 6 3 A 1.5 1.5 0 1 1 6 0 Z M 10.5 0 A 1.5 1.5 0 1 1 10.5 3 A 1.5 1.5 0 1 1 10.5 0 Z" />
                                        </Button>
                                        <Button Classes="icon small" Click="OnMinimizeClick" AutomationProperties.Name="Minimize">
                                            <Border Width="9" Height="1.6" CornerRadius="1" Background="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                        <Button Classes="icon small" Command="{Binding QuitCommand}" AutomationProperties.Name="Quit">
                                            <Path Width="8" Height="8" Data="M 5 5 L 19 19 M 19 5 L 5 19" />
                                        </Button>
                                    </StackPanel>
                                </Panel>
                            </Grid>

                            <!-- The time, and what to do next. -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                                <TextBlock x:Name="TimeLabel" Classes="digits" Classes.overrun="{Binding IsOverrun}"
                                           Text="{Binding #Root.TimeDisplay}" VerticalAlignment="Center" Margin="-2,-4,0,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2" Classes="reveal" Classes.shown="{Binding #Root.Hovering}">
                                        <Button Classes="icon" Command="{Binding SkipCommand}" IsVisible="{Binding CanSkip}" AutomationProperties.Name="Skip the break">
                                            <Path Width="12" Height="12" Data="M 5 5 L 14 12 L 5 19 Z M 19 5 V 19" />
                                        </Button>
                                        <Button Classes="icon" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" AutomationProperties.Name="Stop">
                                            <Path Width="11" Height="11" Data="M 6 6 H 18 V 18 H 6 Z" />
                                        </Button>
                                    </StackPanel>
                                    <Button Classes="go" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" AutomationProperties.Name="Start">
                                        <Path Width="13" Height="14" Margin="3,0,0,0" Data="M 0 0 L 12 7 L 0 14 Z" />
                                    </Button>
                                    <Button Classes="go" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" AutomationProperties.Name="Pause">
                                        <Path Width="11" Height="13" Data="M 0 0 H 4 V 14 H 0 Z M 7 0 H 11 V 14 H 7 Z" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Progress: a hairline along the bottom edge, in the state's colour. -->
                        <Border VerticalAlignment="Bottom" Height="2" Margin="18,0,18,7" CornerRadius="1" Background="#12FFFFFF" />
                        <Border x:Name="ProgressFill" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="2" Margin="18,0,0,7"
                                CornerRadius="1" Background="{Binding #Root.StateBrush}" Width="0" />

                        <Border x:Name="Glow" Classes.on="{Binding IsAlerting}" Margin="-1" />
                    </Panel>
                </Border>
            </Panel>
        </Viewbox>
    </Panel>
</w:TimerWindowBase>
