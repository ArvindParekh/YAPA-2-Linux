<w:TimerWindowBase xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:w="using:YAPA.Avalonia.Windows"
                   xmlns:vm="using:YAPA.Avalonia.ViewModels"
                   x:Class="YAPA.Avalonia.Windows.MotivationalWindow"
                   x:DataType="vm:TimerViewModel"
                   x:Name="Root"
                   Classes="transparent"
                   Width="360" Height="220">

    <w:TimerWindowBase.Styles>
        <Style Selector="Button.action">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.window">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </w:TimerWindowBase.Styles>


    <Panel>
        <Border x:Name="Card" CornerRadius="10" Background="#E61A1A2E" />
        <Border CornerRadius="10" Classes="flash"
                Classes.work="{Binding IsWorkEndedAlert}"
                Classes.break="{Binding IsBreakEndedAlert}"
                Classes.on="{Binding IsAlerting}" />

        <Grid Margin="16,10,16,10" RowDefinitions="Auto,*,Auto,Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusLabel"
                           Foreground="{Binding #Root.TextBrush}"
                           FontSize="11" FontWeight="Medium" Opacity="0.8" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding StatusText}" /><Run Text="{Binding CycleSuffix}" FontWeight="Normal" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Classes="controls" Classes.concealed="{Binding !#Root.ControlsVisible}">
                    <Button x:Name="MenuButton" Classes="chrome window" Content="⋯" Click="OnMenuClick" />
                <Button Classes="chrome window" Content="–" Click="OnMinimizeClick" />
                    <Button Classes="chrome window" Content="×" Command="{Binding QuitCommand}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="QuoteText" Foreground="{Binding #Root.TextBrush}"
                           FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Opacity="0.92" />
                <TextBlock x:Name="QuoteSource" Foreground="{Binding #Root.TextBrush}"
                           FontSize="10" HorizontalAlignment="Center" Opacity="0.6" />
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="TimeLabel" Classes="digits"
                       Text="{Binding TimeText}"
                       Foreground="{Binding #Root.TextBrush}"
                       FontFamily="{StaticResource TimerFont}"
                       FontWeight="Light" FontSize="40"
                       HorizontalAlignment="Center" Margin="0,2" />

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="40,0,40,6">
                <!-- MinWidth 0: the theme gives a horizontal ProgressBar a minimum wider than this column. -->
                <ProgressBar x:Name="ProgressLine" Classes="phase" MinWidth="0" Classes.break="{Binding IsBreakInterval}"
                             Minimum="0" Maximum="1" Value="{Binding Progress}"
                             Height="3" MinHeight="3" CornerRadius="2"
                             Background="#22FFFFFF" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="digits"
                           Text="{Binding GoalForecastText}" IsVisible="{Binding HasGoalForecast}"
                           Foreground="{Binding #Root.TextBrush}"
                           FontSize="10" Opacity="0.7" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6"
                        Classes="controls" Classes.concealed="{Binding !#Root.ControlsVisible}">
                <Button Classes="chrome action" Content="SKIP"
                        Command="{Binding SkipCommand}" IsVisible="{Binding CanSkip}" />
                <Button Classes="chrome action" Content="{Binding StartLabel}"
                        Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                <Button Classes="chrome action" Content="PAUSE"
                        Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" />
                <Button Classes="chrome action" Content="STOP"
                        Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" />
            </StackPanel>
        </Grid>
    </Panel>
</w:TimerWindowBase>
