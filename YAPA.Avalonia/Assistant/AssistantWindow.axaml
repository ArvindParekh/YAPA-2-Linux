<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:YAPA.Avalonia.Assistant"
        x:Class="YAPA.Avalonia.Assistant.AssistantWindow"
        x:DataType="a:AssistantViewModel"
        Classes="transparent"
        Title="Ask YAPA"
        Width="400" Height="600"
        RequestedThemeVariant="Dark"
        FontFamily="{StaticResource UiFont}">

    <!--
      A card in a larger transparent window: the margin is room for the drawn shadow and for
      the card to grow into, and an X11 input shape lets clicks through everywhere but the card.
      No tooltips anywhere: Mutter ends Show Desktop whenever a new window maps.
    -->
    <Window.Styles>
        <Style Selector="Border#Card">
            <Setter Property="Width" Value="360" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F5222228" />
                    <GradientStop Offset="1" Color="#F516161A" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#38FFFFFF" />
                    <GradientStop Offset="1" Color="#14FFFFFF" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 18 44 -10 #A0000000, 0 3 12 0 #50000000" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(6px) scale(0.97)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Card.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
        </Style>
        <Style Selector="Border#Card.above">
            <Setter Property="RenderTransform" Value="translateY(-6px) scale(0.97)" />
        </Style>
        <Style Selector="Border#Card.above.shown">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#A8FFFFFF" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.question">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style Selector="SelectableTextBlock.answer">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SelectionBrush" Value="#553E9BFF" />
        </Style>
        <Style Selector="SelectableTextBlock.answer.error">
            <Setter Property="Foreground" Value="#FFF0A39A" />
        </Style>
        <Style Selector="TextBlock.action">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#C8FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="StackPanel.exchange">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.exchange.older">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Flat text-ish buttons that belong to the card. -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#DDFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30FFFFFF" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#B8FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>

        <Style Selector="Button.round">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="#FF16161A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF16161A" />
        </Style>
        <Style Selector="Button.round:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D9FFFFFF" />
        </Style>
        <Style Selector="Button.round:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <!-- The prompt: no box of its own; the pill around it is the field. -->
        <Style Selector="TextBox.prompt">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFFFF" />
            <Setter Property="SelectionBrush" Value="#663E9BFF" />
            <Setter Property="Padding" Value="4,9" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="120" />
        </Style>
        <Style Selector="TextBox.prompt /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="#6BFFFFFF" />
        </Style>
        <Style Selector="TextBox.prompt:focus /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="#6BFFFFFF" />
        </Style>

        <Style Selector="Border.field">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.field.focused">
            <Setter Property="BorderBrush" Value="#3DFFFFFF" />
        </Style>

        <!-- "…" while an answer is on its way. -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="#B0FFFFFF" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="60%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.dot.second">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite" Delay="0:0:0.15">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="60%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.dot.third">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite" Delay="0:0:0.3">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="60%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="ScrollViewer#Scroller /template/ ScrollBar">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Scrolled, text slides away under a fade rather than being cut mid-line. -->
        <Style Selector="ScrollViewer#Scroller.scrolled">
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.08" Color="Black" />
                    <GradientStop Offset="1" Color="Black" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </Window.Styles>

    <Panel>
        <Border x:Name="Card" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                <!-- Orb and what it's doing. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,12,10,4">
                    <a:OrbControl x:Name="Orb" Width="52" Height="52" Margin="-4,-4,0,-4"
                                  Mood="{Binding Mood}" Palette="{Binding Palette}" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Caption}"
                               VerticalAlignment="Center" Margin="10,0,6,0" />
                    <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" Margin="0,8,0,0"
                            Command="{Binding NewConversationCommand}" IsVisible="{Binding HasConversation}" Click="OnNewConversationClick"
                            AutomationProperties.Name="New conversation">
                        <!-- A pencil on a page: start afresh. -->
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M 11 3 L 13 5 L 6.5 11.5 L 4 12 L 4.5 9.5 Z M 9.5 4.5 L 11.5 6.5 M 2 7 L 2 14 L 9 14" />
                    </Button>
                </Grid>

                <!-- A few things to ask, until there's a conversation. -->
                <ItemsControl Grid.Row="1" x:Name="SuggestionList" ItemsSource="{Binding Suggestions}"
                              IsVisible="{Binding ShowSuggestions}" Margin="16,6,10,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="a:Suggestion">
                            <Button Classes="chip" Content="{Binding Label}" Click="OnSuggestionClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The conversation. -->
                <ScrollViewer Grid.Row="2" x:Name="Scroller" IsVisible="{Binding HasConversation}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Margin="0,2,0,0">
                    <ItemsControl ItemsSource="{Binding Exchanges}" Margin="0,0,0,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="a:Exchange">
                                <StackPanel Classes="exchange" Classes.older="{Binding !IsLatest}" Margin="20,8,20,6" Spacing="5">
                                    <TextBlock Classes="question" Text="{Binding Question}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4"
                                                IsVisible="{Binding IsWaiting}">
                                        <Ellipse Classes="dot" />
                                        <Ellipse Classes="dot second" />
                                        <Ellipse Classes="dot third" />
                                    </StackPanel>
                                    <SelectableTextBlock Classes="answer" Classes.error="{Binding IsError}" Text="{Binding Answer}"
                                                         IsVisible="{Binding Answer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                                    <Border Width="15" Height="15" CornerRadius="8" Background="#2E5AD48B"
                                                            VerticalAlignment="Top" Margin="0,1,7,0">
                                                        <Path Width="8" Height="8" Stretch="Uniform" Stroke="#FF7EE2A8" StrokeThickness="1.8"
                                                              StrokeLineCap="Round" StrokeJoin="Round" Data="M 1 5 L 4 8 L 9 2" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="action" Text="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-6,0,0,0">
                                        <Button Classes="link" Content="Undo" IsVisible="{Binding CanUndo}"
                                                Click="OnUndoClick" AutomationProperties.Name="Undo what this did" />
                                        <TextBlock Classes="action" Text="Undone" Foreground="#80FFFFFF" Margin="6,2,0,0"
                                                   IsVisible="{Binding WasUndone}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- The prompt. -->
                <Border Grid.Row="3" x:Name="Field" Classes="field" Margin="12,8,12,12"
                        IsVisible="{Binding !IsUnavailable}">
                    <Grid ColumnDefinitions="*,Auto" Margin="10,0,5,0">
                        <TextBox x:Name="Prompt" Classes="prompt" Text="{Binding Input}"
                                 PlaceholderText="{Binding Placeholder}"
                                 AcceptsReturn="False" />
                        <Button Grid.Column="1" Classes="round" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                Command="{Binding SubmitCommand}" IsVisible="{Binding !IsBusy}"
                                IsEnabled="{Binding Input, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                AutomationProperties.Name="Send">
                            <Path Width="12" Height="13" Stretch="Uniform" StrokeThickness="2"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M 6 13 L 6 1 M 1 6 L 6 1 L 11 6" />
                        </Button>
                        <Button Grid.Column="1" Classes="round" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}"
                                AutomationProperties.Name="Stop">
                            <Border Width="10" Height="10" CornerRadius="2.5" Background="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
