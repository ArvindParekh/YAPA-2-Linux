<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:YAPA.Avalonia.Assistant"
        x:Class="YAPA.Avalonia.Assistant.AssistantWindow"
        x:DataType="a:AssistantViewModel"
        Classes="transparent"
        Title="Ask YAPA"
        Width="500" Height="600"
        RequestedThemeVariant="Dark"
        TextOptions.TextRenderingMode="Antialias"
        FontFamily="{StaticResource UiFont}">

    <!--
      The command bar: one field that runs actions and asks YAPA. The field is on top, as in any
      command palette; under it, what matches (before a conversation) or the conversation; at the
      foot, what the orb is doing and the keys that work right now.

      A card in a larger transparent window: the margin is room for the drawn shadow and for
      the card to grow into, and an X11 input shape lets clicks through everywhere but the card.
      No tooltips anywhere: Mutter ends Show Desktop whenever a new window maps.
    -->
    <Window.Styles>
        <Style Selector="Border#Card">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FA17171B" />
                    <GradientStop Offset="1" Color="#FA101013" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#26FFFFFF" />
                    <GradientStop Offset="1" Color="#12FFFFFF" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 24 48 -12 #C0000000, 0 4 14 0 #50000000" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(6px) scale(0.98)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Card.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
        </Style>
        <Style Selector="Border#Card.above">
            <Setter Property="RenderTransform" Value="translateY(-6px) scale(0.98)" />
        </Style>
        <Style Selector="Border#Card.above.shown">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
        </Style>

        <Style Selector="Border.divider">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- ── The list ────────────────────────────────────────────────── -->
        <Style Selector="TextBlock.groupHead">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Text3}" />
            <Setter Property="Margin" Value="12,10,0,5" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.row.selected">
            <Setter Property="Background" Value="{StaticResource FillActive}" />
        </Style>
        <Style Selector="Border.rowIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource FillSubtle}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,11,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.rowIcon.ask">
            <Setter Property="Background" Value="{StaticResource FocusSoft}" />
            <Setter Property="BorderBrush" Value="#38FF6A3D" />
        </Style>
        <Style Selector="Path.rowGlyph">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{StaticResource Text2}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.row.selected Path.rowGlyph">
            <Setter Property="Stroke" Value="{StaticResource Text1}" />
        </Style>
        <Style Selector="Border.rowIcon.ask Path.rowGlyph">
            <Setter Property="Stroke" Value="{StaticResource Focus}" />
        </Style>
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.row.selected TextBlock.rowTitle">
            <Setter Property="Foreground" Value="{StaticResource Text1}" />
        </Style>
        <Style Selector="TextBlock.rowTag">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Text3}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,2,0" />
        </Style>
        <Style Selector="Border.row Border.kbd">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── The conversation ────────────────────────────────────────── -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Text3}" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.caption.lead">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
        </Style>

        <Style Selector="Border.question">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Margin" Value="48,0,0,0" />
            <Setter Property="Padding" Value="12,7,12,8" />
            <Setter Property="CornerRadius" Value="12,12,4,12" />
            <Setter Property="Background" Value="{StaticResource FillActive}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="SelectableTextBlock.question">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource Text1}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SelectionBrush" Value="#55FF6A3D" />
        </Style>
        <Style Selector="SelectableTextBlock.answer">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource Text1}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SelectionBrush" Value="#55FF6A3D" />
        </Style>
        <Style Selector="ItemsControl.answer.error SelectableTextBlock.answer">
            <Setter Property="Foreground" Value="#FFF0A39A" />
        </Style>
        <Style Selector="Grid.block.paragraph">
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>
        <Style Selector="Grid.block.item">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style Selector="Grid.block.item.paragraph">
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>
        <!-- Centred on the first line (line height 22): a wrapped item's next lines align with its text. -->
        <Style Selector="Ellipse.bullet">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="{StaticResource Text3}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="3,9,11,0" />
        </Style>
        <Style Selector="Button.jump">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="{StaticResource Overlay}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Text1}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.jump.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.jump:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF2A2A30" />
        </Style>
        <!-- Copy is faint until the answer is pointed at, and stays a moment as a tick once used. -->
        <Style Selector="Button.copy">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.exchange:pointerover Button.copy">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.copy.done">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.action">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="StackPanel.exchange">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
            <!-- A new exchange fades in rather than popping into place. -->
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Backward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="StackPanel.exchange.older">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Dimmed to keep the eye on the latest, but there to read when pointed at. -->
        <Style Selector="StackPanel.exchange.older:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FillHover}" />
            <Setter Property="Foreground" Value="{StaticResource Text1}" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FillActive}" />
        </Style>

        <!-- Send and stop: small and white, the one thing to press while talking. -->
        <Style Selector="Button.round">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Text1}" />
            <Setter Property="Foreground" Value="{StaticResource Canvas}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource Canvas}" />
        </Style>
        <Style Selector="Button.round:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D9FFFFFF" />
        </Style>
        <Style Selector="Button.round:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FillActive}" />
            <Setter Property="Foreground" Value="{StaticResource Text4}" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text3}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FillHover}" />
            <Setter Property="Foreground" Value="{StaticResource Text1}" />
        </Style>

        <!-- The field: no box of its own; the card's top is the field. -->
        <Style Selector="TextBox.prompt">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="Foreground" Value="{StaticResource Text1}" />
            <Setter Property="CaretBrush" Value="{StaticResource Focus}" />
            <Setter Property="SelectionBrush" Value="#66FF6A3D" />
            <Setter Property="Padding" Value="2,16" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
            <!-- Six lines, then it scrolls inside. -->
            <Setter Property="MaxHeight" Value="160" />
        </Style>
        <Style Selector="TextBox.prompt /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="{StaticResource Text4}" />
        </Style>
        <Style Selector="TextBox.prompt:focus /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="{StaticResource Text3}" />
        </Style>

        <!-- Signing in to Claude: a line and one button, under the field. -->
        <Style Selector="Border.signin">
            <Setter Property="Background" Value="{StaticResource HoldSoft}" />
            <Setter Property="BorderBrush" Value="#30F5B544" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="10,0,10,10" />
        </Style>
        <Style Selector="TextBlock.signin">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource Text1}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="ScrollViewer /template/ ScrollBar">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Scrolled, text slides away under a fade rather than being cut mid-line. -->
        <Style Selector="ScrollViewer#Scroller.scrolled">
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.06" Color="Black" />
                    <GradientStop Offset="1" Color="Black" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <!-- And at the bottom while there's more below, so it's clear the conversation goes on. -->
        <Style Selector="ScrollViewer#Scroller.more">
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="Black" />
                    <GradientStop Offset="0.9" Color="Black" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="ScrollViewer#Scroller.scrolled.more">
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.06" Color="Black" />
                    <GradientStop Offset="0.9" Color="Black" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="StackPanel.hints TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Text3}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.hints Border.kbd > TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
        </Style>
    </Window.Styles>

    <Panel>
        <Border x:Name="Card" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- The field, with the orb as its mark. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,0,10,0">
                    <a:OrbControl x:Name="Orb" Width="34" Height="34" Margin="-4,0,6,0" VerticalAlignment="Center"
                                  Mood="{Binding Mood}" Palette="{Binding Palette}" />
                    <!-- Enter runs the selected row, or sends; Shift+Enter is a new line. -->
                    <TextBox Grid.Column="1" x:Name="Prompt" Classes="prompt" Text="{Binding Input}"
                             AcceptsReturn="True" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <Button Classes="icon" Command="{Binding NewConversationCommand}" Click="OnNewConversationClick"
                                IsVisible="{Binding HasConversation}" AutomationProperties.Name="New conversation">
                            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.7"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M 12 5 V 19 M 5 12 H 19" />
                        </Button>
                        <Button x:Name="SendButton" Classes="round" Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding Input, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                AutomationProperties.Name="Send">
                            <Path Width="11" Height="12" Stretch="Uniform" StrokeThickness="2"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M 6 13 L 6 1 M 1 6 L 6 1 L 11 6" />
                        </Button>
                        <Button Classes="round" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}"
                                AutomationProperties.Name="Stop">
                            <Border Width="9" Height="9" CornerRadius="2" Background="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Signed out of Claude, or about to be. -->
                <Border Grid.Row="1" Classes="signin" IsVisible="{Binding ShowSignIn}">
                    <Grid ColumnDefinitions="*,Auto" Margin="12,8,6,8">
                        <TextBlock Classes="signin" Text="{Binding SignInText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="primary" Content="{Binding SignInButton}"
                                Command="{Binding SignInCommand}" IsVisible="{Binding !IsSigningIn}"
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Grid.Column="1" Classes="link" Content="Cancel"
                                Command="{Binding CancelSignInCommand}" IsVisible="{Binding IsSigningIn}"
                                VerticalAlignment="Center" Margin="12,0,2,0" />
                    </Grid>
                </Border>

                <!-- What's under the field: the list, or the conversation. Takes what's left of the
                     card's height, so the field can grow without pushing out of the card. -->
                <Border Grid.Row="2" x:Name="Body" Classes="divider">
                    <Panel>
                        <ScrollViewer x:Name="ListScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="List" Margin="6,2,6,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="a:PaletteRow">
                                        <StackPanel>
                                            <TextBlock Classes="groupHead" Text="{Binding Header}" IsVisible="{Binding HasHeader}" />
                                            <Border Classes="row" Classes.selected="{Binding IsSelected}"
                                                    PointerEntered="OnRowPointerEntered" PointerReleased="OnRowPointerReleased">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Classes="rowIcon" Classes.ask="{Binding IsAsk}">
                                                        <Path Classes="rowGlyph" Data="{Binding Icon}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="rowTitle" Text="{Binding Title}" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <TextBlock Classes="rowTag" Text="Ask YAPA" IsVisible="{Binding IsAsk}" />
                                                        <ItemsControl ItemsSource="{Binding Keys}" IsVisible="{Binding HasKeys}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border Classes="kbd"><TextBlock Text="{Binding}" /></Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Panel x:Name="Conversation">
                            <ScrollViewer x:Name="Scroller"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Exchanges}" Margin="0,4,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="a:Exchange">
                                            <StackPanel Classes="exchange" Classes.older="{Binding !IsLatest}" Margin="20,12,18,2" Spacing="8">
                                                <!-- What was asked, as a bubble on the right: the turns read as turns. -->
                                                <Border Classes="question">
                                                    <SelectableTextBlock Classes="question" Text="{Binding Question}" />
                                                </Border>
                                                <ItemsControl Classes="answer" Classes.error="{Binding IsError}" ItemsSource="{Binding Blocks}"
                                                              IsVisible="{Binding HasAnswer}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="a:AnswerBlock">
                                                            <Grid ColumnDefinitions="Auto,*" Classes="block" Classes.paragraph="{Binding StartsParagraph}"
                                                                  Classes.item="{Binding IsBullet}">
                                                                <Ellipse Classes="bullet" IsVisible="{Binding IsBullet}" />
                                                                <SelectableTextBlock Grid.Column="1" Classes="answer" Text="{Binding Text}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}" Margin="0,2,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                                                <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource RestSoft}"
                                                                        VerticalAlignment="Top" Margin="0,0,8,0">
                                                                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{StaticResource Rest}" StrokeThickness="1.8"
                                                                          StrokeLineCap="Round" StrokeJoin="Round" Data="M 1 5 L 4 8 L 9 2" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Classes="action" Text="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- What it's doing, always last: under the question at first, then under whatever it has said or done so far. -->
                                                <a:StatusLine Status="{Binding Status}" IsVisible="{Binding ShowStatus}" Margin="-2,1,0,1" />
                                                <!-- What can be done with the answer: Undo, Try again, Copy. -->
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Height="24" Margin="-6,-4,-4,0" IsVisible="{Binding HasFooter}">
                                                    <Button Classes="link" Content="Undo" IsVisible="{Binding CanUndo}"
                                                            Click="OnUndoClick" AutomationProperties.Name="Undo what this did" />
                                                    <TextBlock Grid.Column="1" Classes="action" Text="Undone" Foreground="{StaticResource Text3}" Margin="6,0,0,0"
                                                               IsVisible="{Binding WasUndone}" />
                                                    <Button Grid.Column="2" Classes="link" Content="Try again" IsVisible="{Binding CanRetry}"
                                                            Click="OnRetryClick" AutomationProperties.Name="Ask this again" />
                                                    <Button Grid.Column="4" Classes="icon copy" Classes.done="{Binding Copied}" IsVisible="{Binding CanCopy}"
                                                            Click="OnCopyClick" AutomationProperties.Name="Copy the answer">
                                                        <Panel>
                                                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6" IsVisible="{Binding !Copied}"
                                                                  Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                                                                  Data="M 8 8 V 5 A 2 2 0 0 1 10 3 H 19 A 2 2 0 0 1 21 5 V 14 A 2 2 0 0 1 19 16 H 16 M 5 8 H 14 A 2 2 0 0 1 16 10 V 19 A 2 2 0 0 1 14 21 H 5 A 2 2 0 0 1 3 19 V 10 A 2 2 0 0 1 5 8 Z" />
                                                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.9" IsVisible="{Binding Copied}"
                                                                  Stroke="{StaticResource Rest}" StrokeLineCap="Round" StrokeJoin="Round" Data="M 4 12.5 L 9.5 18 L 20 6.5" />
                                                        </Panel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Scrolled up while more is there below: one click back to the end. -->
                            <Button x:Name="JumpButton" Classes="jump" Click="OnJumpClick" AutomationProperties.Name="Go to the latest">
                                <Path Width="10" Height="11" Stretch="Uniform" StrokeThickness="2"
                                      Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M 6 1 L 6 13 M 1 8 L 6 13 L 11 8" />
                            </Button>
                        </Panel>
                    </Panel>
                </Border>

                <!-- The foot: what the orb is doing, and the keys that work now. -->
                <Border Grid.Row="3" Classes="divider" Background="#06FFFFFF" CornerRadius="0,0,15,15">
                    <Grid ColumnDefinitions="*,Auto" Margin="14,8,10,8" MinHeight="22">
                        <TextBlock x:Name="CaptionText" Classes="caption" Text="{Binding Caption}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" x:Name="Hints" Classes="hints" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
