<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:YAPA.Avalonia.Assistant"
        x:Class="YAPA.Avalonia.Assistant.AssistantWindow"
        x:DataType="a:AssistantViewModel"
        Classes="transparent"
        Title="Ask YAPA"
        Width="400" Height="600"
        RequestedThemeVariant="Dark"
        FontFamily="{StaticResource UiFont}">

    <!--
      A card in a larger transparent window: the margin is room for the drawn shadow and for
      the card to grow into, and an X11 input shape lets clicks through everywhere but the card.
      No tooltips anywhere: Mutter ends Show Desktop whenever a new window maps.
    -->
    <Window.Styles>
        <Style Selector="Border#Card">
            <Setter Property="Width" Value="380" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F5222228" />
                    <GradientStop Offset="1" Color="#F516161A" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#38FFFFFF" />
                    <GradientStop Offset="1" Color="#14FFFFFF" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 18 44 -10 #A0000000, 0 3 12 0 #50000000" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(6px) scale(0.97)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Card.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
        </Style>
        <Style Selector="Border#Card.above">
            <Setter Property="RenderTransform" Value="translateY(-6px) scale(0.97)" />
        </Style>
        <Style Selector="Border#Card.above.shown">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#A8FFFFFF" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.question">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MaxWidth" Value="292" />
            <Setter Property="Margin" Value="36,0,0,0" />
            <Setter Property="Padding" Value="13,7,13,8" />
            <Setter Property="CornerRadius" Value="16,16,5,16" />
            <Setter Property="Background" Value="#17FFFFFF" />
        </Style>
        <Style Selector="SelectableTextBlock.question">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SelectionBrush" Value="#553E9BFF" />
        </Style>
        <Style Selector="SelectableTextBlock.answer">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SelectionBrush" Value="#553E9BFF" />
        </Style>
        <Style Selector="ItemsControl.answer.error SelectableTextBlock.answer">
            <Setter Property="Foreground" Value="#FFF0A39A" />
        </Style>
        <Style Selector="Grid.block.paragraph">
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>
        <Style Selector="Grid.block.item">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style Selector="Grid.block.item.paragraph">
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>
        <!-- Centred on the first line (line height 22): a wrapped item's next lines align with its text. -->
        <Style Selector="Ellipse.bullet">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="#8CFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="3,9,11,0" />
        </Style>
        <Style Selector="Button.jump">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="#FF2C2C33" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DDFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.jump.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.jump:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF38383F" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <!-- Copy shows on the answer under the pointer, and stays a moment as a tick once used. -->
        <Style Selector="Button.copy">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.exchange:pointerover Button.copy">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.copy.done">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.action">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#C8FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="StackPanel.exchange">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
            <!-- A new exchange fades in rather than popping into place. -->
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Backward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="StackPanel.exchange.older">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Dimmed to keep the eye on the latest, but there to read when pointed at. -->
        <Style Selector="StackPanel.exchange.older:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Flat text-ish buttons that belong to the card. -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#DDFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30FFFFFF" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#B8FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>

        <Style Selector="Button.round">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="#FF16161A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF16161A" />
        </Style>
        <Style Selector="Button.round:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D9FFFFFF" />
        </Style>
        <Style Selector="Button.round:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <!-- The prompt: no box of its own; the pill around it is the field. -->
        <Style Selector="TextBox.prompt">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFFFF" />
            <Setter Property="SelectionBrush" Value="#663E9BFF" />
            <Setter Property="Padding" Value="4,9" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <!-- Six lines, then it scrolls inside. -->
            <Setter Property="MaxHeight" Value="140" />
        </Style>
        <Style Selector="TextBox.prompt /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.prompt /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="#6BFFFFFF" />
        </Style>
        <Style Selector="TextBox.prompt:focus /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="#6BFFFFFF" />
        </Style>

        <Style Selector="Border.field">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.field.focused">
            <Setter Property="BorderBrush" Value="#3DFFFFFF" />
        </Style>

        <!-- Signing in to Claude: a line and one button, in the prompt's place. -->
        <Style Selector="Border.signin">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Margin" Value="12,8,12,0" />
        </Style>
        <Style Selector="Border.signin.alone">
            <Setter Property="Margin" Value="12,8,12,12" />
        </Style>
        <Style Selector="TextBlock.signin">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="#D0FFFFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.pill">
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="#FF16161A" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF16161A" />
        </Style>
        <Style Selector="Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D9FFFFFF" />
        </Style>

        <Style Selector="ScrollViewer#Scroller /template/ ScrollBar">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Scrolled, text slides away under a fade rather than being cut mid-line. -->
        <Style Selector="ScrollViewer#Scroller.scrolled">
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.08" Color="Black" />
                    <GradientStop Offset="1" Color="Black" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <!-- And at the bottom while there's more below, so it's clear the conversation goes on. -->
        <Style Selector="ScrollViewer#Scroller.more">
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="Black" />
                    <GradientStop Offset="0.9" Color="Black" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="ScrollViewer#Scroller.scrolled.more">
            <Setter Property="OpacityMask">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.08" Color="Black" />
                    <GradientStop Offset="0.9" Color="Black" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </Window.Styles>

    <Panel>
        <Border x:Name="Card" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

                <!-- Orb and what it's doing. -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,12,10,4">
                    <a:OrbControl x:Name="Orb" Width="52" Height="52" Margin="-4,-4,0,-4"
                                  Mood="{Binding Mood}" Palette="{Binding Palette}" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Caption}"
                               VerticalAlignment="Center" Margin="10,0,6,0" />
                    <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" Margin="0,8,0,0"
                            Command="{Binding NewConversationCommand}" IsVisible="{Binding HasConversation}" Click="OnNewConversationClick"
                            AutomationProperties.Name="New conversation">
                        <!-- A speech bubble with a plus: a new conversation. -->
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M 6 4.5 H 18 A 3 3 0 0 1 21 7.5 V 14.5 A 3 3 0 0 1 18 17.5 H 11 L 7 20.5 V 17.5 H 6 A 3 3 0 0 1 3 14.5 V 7.5 A 3 3 0 0 1 6 4.5 Z M 12 8 V 14 M 9 11 H 15" />
                    </Button>
                </Grid>

                <!-- A few things to ask, until there's a conversation. -->
                <ItemsControl Grid.Row="1" x:Name="SuggestionList" ItemsSource="{Binding Suggestions}"
                              IsVisible="{Binding ShowSuggestions}" Margin="16,6,10,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="a:Suggestion">
                            <Button Classes="chip" Content="{Binding Label}" Click="OnSuggestionClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The conversation. It takes what's left of the card's height, so the prompt can grow. -->
                <Panel Grid.Row="2" IsVisible="{Binding HasConversation}">
                <ScrollViewer x:Name="Scroller"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Margin="0,2,0,0">
                    <ItemsControl ItemsSource="{Binding Exchanges}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="a:Exchange">
                                <StackPanel Classes="exchange" Classes.older="{Binding !IsLatest}" Margin="20,10,16,2" Spacing="8">
                                    <!-- What was asked, as a bubble on the right: the turns read as turns. -->
                                    <Border Classes="question">
                                        <SelectableTextBlock Classes="question" Text="{Binding Question}" />
                                    </Border>
                                    <ItemsControl Classes="answer" Classes.error="{Binding IsError}" ItemsSource="{Binding Blocks}"
                                                  IsVisible="{Binding HasAnswer}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="a:AnswerBlock">
                                                <Grid ColumnDefinitions="Auto,*" Classes="block" Classes.paragraph="{Binding StartsParagraph}"
                                                      Classes.item="{Binding IsBullet}">
                                                    <Ellipse Classes="bullet" IsVisible="{Binding IsBullet}" />
                                                    <SelectableTextBlock Grid.Column="1" Classes="answer" Text="{Binding Text}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#2E5AD48B"
                                                            VerticalAlignment="Top" Margin="0,0,8,0">
                                                        <Path Width="8" Height="8" Stretch="Uniform" Stroke="#FF7EE2A8" StrokeThickness="1.8"
                                                              StrokeLineCap="Round" StrokeJoin="Round" Data="M 1 5 L 4 8 L 9 2" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="action" Text="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- What it's doing, always last: under the question at first, then under whatever it has said or done so far. -->
                                    <a:StatusLine Status="{Binding Status}" IsVisible="{Binding ShowStatus}" Margin="-2,1,0,1" />
                                    <!-- What can be done with the answer: Undo, Try again, Copy. -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Height="24" Margin="-6,-4,-4,0" IsVisible="{Binding HasFooter}">
                                        <Button Classes="link" Content="Undo" IsVisible="{Binding CanUndo}"
                                                Click="OnUndoClick" AutomationProperties.Name="Undo what this did" />
                                        <TextBlock Grid.Column="1" Classes="action" Text="Undone" Foreground="#80FFFFFF" Margin="6,0,0,0"
                                                   IsVisible="{Binding WasUndone}" />
                                        <Button Grid.Column="2" Classes="link" Content="Try again" IsVisible="{Binding CanRetry}"
                                                Click="OnRetryClick" AutomationProperties.Name="Ask this again" />
                                        <Button Grid.Column="4" Classes="icon copy" Classes.done="{Binding Copied}" IsVisible="{Binding CanCopy}"
                                                Click="OnCopyClick" AutomationProperties.Name="Copy the answer">
                                            <Panel>
                                                <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6" IsVisible="{Binding !Copied}"
                                                      Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Data="M 8 8 V 5 A 2 2 0 0 1 10 3 H 19 A 2 2 0 0 1 21 5 V 14 A 2 2 0 0 1 19 16 H 16 M 5 8 H 14 A 2 2 0 0 1 16 10 V 19 A 2 2 0 0 1 14 21 H 5 A 2 2 0 0 1 3 19 V 10 A 2 2 0 0 1 5 8 Z" />
                                                <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.9" IsVisible="{Binding Copied}"
                                                      Stroke="#FF7EE2A8" StrokeLineCap="Round" StrokeJoin="Round" Data="M 4 12.5 L 9.5 18 L 20 6.5" />
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Scrolled up while more is there below: one click back to the end. -->
                <Button x:Name="JumpButton" Classes="jump" Click="OnJumpClick" AutomationProperties.Name="Go to the latest">
                    <Path Width="10" Height="11" Stretch="Uniform" StrokeThickness="2"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                          Data="M 6 1 L 6 13 M 1 8 L 6 13 L 11 8" />
                </Button>
                </Panel>

                <!-- Signed out of Claude, or about to be. -->
                <Border Grid.Row="3" Classes="signin" Classes.alone="{Binding NeedsSignIn}" IsVisible="{Binding ShowSignIn}">
                    <Grid ColumnDefinitions="*,Auto" Margin="14,9,7,9">
                        <TextBlock Classes="signin" Text="{Binding SignInText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="pill" Content="{Binding SignInButton}"
                                Command="{Binding SignInCommand}" IsVisible="{Binding !IsSigningIn}"
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Grid.Column="1" Classes="link" Content="Cancel"
                                Command="{Binding CancelSignInCommand}" IsVisible="{Binding IsSigningIn}"
                                VerticalAlignment="Center" Margin="12,0,2,0" />
                    </Grid>
                </Border>

                <!-- The prompt. -->
                <Border Grid.Row="4" x:Name="Field" Classes="field" Margin="12,8,12,12"
                        IsVisible="{Binding ShowPrompt}">
                    <Grid ColumnDefinitions="*,Auto" Margin="10,0,5,0">
                        <!-- Enter sends; Shift+Enter is a new line. -->
                        <TextBox x:Name="Prompt" Classes="prompt" Text="{Binding Input}"
                                 PlaceholderText="{Binding Placeholder}"
                                 AcceptsReturn="True" />
                        <!-- At the bottom, by the last line, as the prompt grows. -->
                        <Button Grid.Column="1" Classes="round" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                Command="{Binding SubmitCommand}" IsVisible="{Binding !IsBusy}"
                                IsEnabled="{Binding Input, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                AutomationProperties.Name="Send">
                            <Path Width="12" Height="13" Stretch="Uniform" StrokeThickness="2"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M 6 13 L 6 1 M 1 6 L 6 1 L 11 6" />
                        </Button>
                        <Button Grid.Column="1" Classes="round" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}"
                                AutomationProperties.Name="Stop">
                            <Border Width="10" Height="10" CornerRadius="2.5" Background="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
