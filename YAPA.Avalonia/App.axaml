<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YAPA.Avalonia.App"
             Name="YAPA 2"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <FontFamily x:Key="TimerFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <FontFamily x:Key="UiFont">avares://YAPA.Avalonia/Assets/Fonts/Geist#Geist</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <!-- One accent, the pomodoro's tomato, for every toggle, slider and selection. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#FFFF6B57" />
                <ColorPaletteResources x:Key="Light" Accent="#FFE0503C" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://YAPA.Avalonia/Windows/TimerStyles.axaml" />

        <!-- Timer windows draw everything themselves: strip Fluent's window chrome. -->
        <Style Selector="Window.transparent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- VisualLayerManager hosts overlays and adorners, and popups on platforms without native ones. -->
                    <VisualLayerManager>
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </VisualLayerManager>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
