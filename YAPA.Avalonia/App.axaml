<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YAPA.Avalonia.App"
             Name="YAPA 2"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <FontFamily x:Key="TimerFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://YAPA.Avalonia/Windows/TimerStyles.axaml" />

        <!-- Timer windows draw everything themselves: strip Fluent's window chrome. -->
        <Style Selector="Window.transparent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
